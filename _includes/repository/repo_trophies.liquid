<div class="repo p-2 text-center">
  <img
    class="only-light w-100"
    alt="{{ include.username }} GitHub Streak"
    src="{{ '/assets/img/github-stats/streak-' | append: include.username | append: '-light.svg' | relative_url }}"
  >
  <img
    class="only-dark w-100"
    alt="{{ include.username }} GitHub Streak"
    src="{{ '/assets/img/github-stats/streak-' | append: include.username | append: '-dark.svg' | relative_url }}"
  >
</div>