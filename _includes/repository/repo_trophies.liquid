<div class="repositories d-flex flex-wrap flex-md-row flex-column justify-content-between align-items-center">
  <div class="repo p-2 text-center">
    <img src="https://github-readme-streak-stats.herokuapp.com/?user={{ include.username }}&theme=transparent&hide_border=true" alt="GitHub Streak">
  </div>
  <div class="repo p-2 text-center">
    <img src="https://github-readme-stats.vercel.app/api/top-langs/?username={{ include.username }}&layout=compact&theme=transparent&hide_border=true&langs_count=8" alt="Top Languages">
  </div>
</div>